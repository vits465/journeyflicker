{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://journeyflicker-backend.vercel.app/api/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://journeyflicker-backend.vercel.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://journeyflicker-backend.vercel.app/uploads/$1"
    },
    {
      "source": "/((?!api|uploads|.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
